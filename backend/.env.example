DATABASE_URL="postgresql://username:password@localhost:5432/examops"
JWT_SECRET="replace_with_a_long_random_secret"
PORT=8000
FRONTEND_URL="http://localhost:5173"

# SMTP for local development only (Render blocks SMTP ports)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your_email@example.com"
SMTP_PASS="your_app_password"

# Brevo for production (HTTPS API, works on Render)
# Create an API key at https://app.brevo.com and verify this sender email in Brevo.
BREVO_API_KEY="xkeysib-xxxxxxxxxxxxxxxx"
BREVO_SENDER_EMAIL="your_verified_email@gmail.com"
BREVO_SENDER_NAME="ExamOps"
