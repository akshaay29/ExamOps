DATABASE_URL="postgresql://username:password@localhost:5432/examops"
JWT_SECRET="replace_with_a_long_random_secret"
PORT=8000

# Set to your deployed frontend URL in production (e.g. https://exam-ops.vercel.app)
# The magic link in emails will point to: {FRONTEND_URL}/auth/callback?token=...
FRONTEND_URL="http://localhost:5173"

# ── SMTP Email Configuration ───────────────────────────────────────────────────
# For Gmail: enable 2FA → generate an App Password at myaccount.google.com/apppasswords
# Port 465 = SSL (secure=true) | Port 587 = STARTTLS (secure=false)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=465
SMTP_USER="your_email@gmail.com"
SMTP_PASS="your_16_char_app_password"
